# Playwright test credentials
#
# Environment-specific credential files:
#   .playwright.env.dev  — committed, dev database defaults (ScenarioBuilder)
#   .playwright.env.prod — gitignored, your personal prod credentials
#
# The auth fixture auto-detects which DB is active by reading the port
# from appsettings.Development.json (Port 3306 = dev, Port 3307 = prod).
#
# To set up prod credentials, copy this file to .playwright.env.prod:
#   cp .playwright.env.example .playwright.env.prod

PLAYWRIGHT_ADMIN_EMAIL=your-email@example.com
PLAYWRIGHT_ADMIN_PASSWORD=your-password
PLAYWRIGHT_USER_EMAIL=
PLAYWRIGHT_USER_PASSWORD=
