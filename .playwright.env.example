# Playwright test credentials
# Copy this file to .playwright.env and fill in your credentials.
# .playwright.env is gitignored and will NOT be committed.
#
# When using the dev database (ScenarioBuilder), the defaults work out of the box.
# When using a prod/live database, set your actual login credentials here.

PLAYWRIGHT_ADMIN_EMAIL=admin@memowikis.net
PLAYWRIGHT_ADMIN_PASSWORD=test
PLAYWRIGHT_USER_EMAIL=user@memowikis.net
PLAYWRIGHT_USER_PASSWORD=test
