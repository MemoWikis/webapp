{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.cs": "${capture}.*.verified.txt, ${capture}.*.received.txt"
  },
  // yeagh i know, should be in the workspace settings, but ...
  "vscode-pets.theme": "forest",

  // Vue/Nuxt TypeScript settings
  "typescript.tsdk": "src/Frontend.Nuxt/node_modules/typescript/lib",
  "vue.server.hybridMode": true,
  "typescript.preferences.autoImportFileExcludePatterns": [
    "@vueuse/core"
  ],

  // Formatter settings (moved from Frontend.Nuxt)
  "editor.formatOnSave": true,
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.semi": false,
    "prettier.singleQuote": true
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.semi": false,
    "prettier.singleQuote": true
  },
  "[vue]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Vue.volar"
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#6244fe",
    "activityBar.background": "#6244fe",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#fe7a60",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#6244fe",
    "statusBar.background": "#3711fe",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#6244fe",
    "statusBarItem.remoteBackground": "#3711fe",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#3711fe",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#3711fe99",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#3711fe"
}
